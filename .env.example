# Django Configuration
DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production-use-a-strong-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL in Docker, SQLite locally if unset)
DATABASE_URL=postgres://approveflow_user:approveflow_password@db:5432/approveflow_db
POSTGRES_DB=approveflow_db
POSTGRES_USER=approveflow_user
POSTGRES_PASSWORD=approveflow_password

# Redis Configuration (Cache & Message Broker)
REDIS_URL=redis://redis:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Host Port Mapping
HOST_PORT=8001

